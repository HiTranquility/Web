<?xml version="1.0" encoding="UTF-8"?>

<!--
================================================================================
  web.xml — Deployment Descriptor
================================================================================
  Dự án này map servlet chủ yếu bằng @WebServlet (gọn, nằm cạnh code).
  File này giữ những thứ KHÔNG có dạng annotation:
      <context-param>   giá trị dùng chung
      <error-page>      trang lỗi tuỳ biến
      <session-config>  thời gian sống của phiên
      <welcome-file>    trang mặc định

  Tomcat đọc file này MỘT LẦN lúc khởi động. Sửa xong phải restart.
================================================================================
-->
<web-app version="3.1"
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
        http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

    <display-name>Web Đọc Truyện</display-name>

    <!--
      BỘ LỌC BẢNG MÃ — phải chạy TRƯỚC mọi thứ khác.

      Khai ở đây chứ KHÔNG dùng @WebFilter, vì thứ tự chạy giữa các filter
      khai bằng annotation là KHÔNG XÁC ĐỊNH. Filter này bắt buộc phải chạy
      trước AuthFilter: AuthFilter đọc getParameter("action") ngay dòng đầu,
      mà một khi tham số đã được đọc thì setCharacterEncoding() gọi sau đó
      vô tác dụng — im lặng, không báo lỗi gì.

      Hậu quả nếu thiếu: tiếng Việt gõ vào form lưu xuống CSDL thành
      "Tráº£ lá»i thá»­". Chỉ POST bị, GET thì không — tham số trên URL do
      connector giải mã và Tomcat 8+ mặc định UTF-8 cho URI.

      Thứ tự các <filter-mapping> trong web.xml được bảo đảm, và Tomcat chạy
      nhóm khai trong web.xml trước nhóm khai bằng annotation.
    -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>truyen.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--
      CHỐNG CSRF — mọi POST phải mang token của phiên.

      PHẢI ĐỨNG SAU EncodingFilter. Filter này gọi getParameter() để đọc
      token, mà tham số một khi đã đọc thì setCharacterEncoding() gọi sau
      không còn tác dụng — đúng cái bẫy đã làm mất dấu tiếng Việt khi gửi
      form. Thứ tự <filter-mapping> trong web.xml được bảo đảm, nên khai ở
      đây chứ không dùng @WebFilter.

      PHẢI ĐỨNG TRƯỚC AuthFilter và AdminFilter (cả hai khai bằng annotation,
      mà Tomcat chạy nhóm web.xml trước nhóm annotation). Request giả mạo nên
      bị chặn từ trước khi tới chỗ kiểm quyền — chặn sớm nhất có thể.

      Lỗ hổng nó vá: trình duyệt tự đính kèm cookie phiên vào mọi request,
      kể cả request do một trang KHÁC tạo ra. Nên chỉ cần admin đang đăng
      nhập lỡ mở một trang độc là trang đó gửi được lệnh khoá tài khoản, gỡ
      truyện... mà admin không bấm gì. Xem util/CsrfUtil để hiểu vì sao token
      chặn được: trang tấn công gửi request thì được, nhưng ĐỌC token thì bị
      chính sách same-origin của trình duyệt cấm.
    -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>truyen.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--
      Thư mục chứa ảnh bìa người dùng tải lên.

      PHẢI NẰM NGOÀI webapp. Để trong webapp thì mỗi lần deploy lại là Tomcat
      xoá sạch thư mục cũ và ảnh của người dùng bay theo. Đây đúng là cái bẫy
      của getRealPath() ở chương 5.

      Để ở đây thay vì viết cứng trong code: đổi máy chỉ cần sửa một dòng.

      AI ĐỌC THAM SỐ NÀY
        util/UploadUtil            — lưu file vào đây
        controller/UploadedFileServlet — đọc file ra, map /uploads/*

      Cần servlet riêng để đọc ra chính vì thư mục nằm NGOÀI webapp: Tomcat
      chỉ tự phục vụ file bên trong webapp. Đó là cái giá của quyết định trên,
      và trả là đúng — đổi lại ảnh không bốc hơi mỗi lần triển khai lại.

      Thư mục KHÔNG có sẵn thì UploadUtil tự tạo ở lần tải ảnh đầu tiên.
    -->
    <context-param>
        <param-name>uploadDir</param-name>
        <param-value>C:/truyen-uploads</param-value>
    </context-param>

    <!-- Số truyện mỗi trang ở kho truyện. Chỉnh mà không cần biên dịch lại. -->
    <context-param>
        <param-name>pageSize</param-name>
        <param-value>24</param-value>
    </context-param>


    <!--
      Ngôn ngữ mặc định cho các thẻ <fmt:...>.

      VÌ SAO CẦN DÒNG NÀY
        JSTL quyết định cách viết số và ngày dựa trên header Accept-Language
        của trình duyệt. Nếu request KHÔNG có header đó, JSTL không chọn được
        ngôn ngữ nào và... in ra số thô, không định dạng gì cả. Nó không báo
        lỗi — chỉ lặng lẽ hiện "31200" thay vì "31.200".

        Trình duyệt luôn gửi header này nên lúc dùng thật sẽ không thấy vấn đề.
        Nhưng công cụ dòng lệnh (curl), bot, hay trình duyệt bị chỉnh cấu hình
        thì không gửi — và trang sẽ hiện khác nhau tuỳ người xem.

      CHỌN fmt.locale CHỨ KHÔNG PHẢI fmt.fallbackLocale
        fallbackLocale chỉ dùng khi trình duyệt không nói gì. Nghĩa là máy cài
        tiếng Anh vẫn thấy "28,360" còn máy tiếng Việt thấy "28.360" — cùng
        một trang, hai kiểu số.

        fmt.locale ghi đè luôn, ai xem cũng thấy như nhau: 28.360. Đây là web
        tiếng Việt, nội dung tiếng Việt, nên định dạng số cũng nên tiếng Việt,
        không phụ thuộc cấu hình máy người đọc.
    -->
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.locale</param-name>
        <param-value>vi_VN</param-value>
    </context-param>


    <!--
      Trang lỗi tuỳ biến.
      Trong lúc phát triển có thể comment lại để thấy stack trace thật.
    -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/page/error404.jsp</location>
    </error-page>

    <!--
      403 Forbidden — TRANG 9.
      Kich hoat khi AdminFilter chan nguoi khong phai admin, hoac khi servlet
      goi sendError(403) vi nguoi dung sua noi dung khong phai cua minh.
      Phai la sendError, khong phai setStatus - setStatus KHONG kich hoat
      error-page.
    -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/page/error403.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/page/error500.jsp</location>
    </error-page>


    <!--
      Phiên đăng nhập sống 60 phút không hoạt động.
      CASE 01 sẽ dùng session để lưu người đang đăng nhập.
    -->
    <session-config>
        <session-timeout>60</session-timeout>

        <!--
          HttpOnly: JavaScript không đọc được cookie phiên. Đây là hàng rào
          thứ hai chống XSS — kể cả khi lọt một đoạn script vào trang, nó cũng
          không cướp được phiên đăng nhập của người khác.
        -->
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>

        <!--
          CHỈ theo dõi phiên bằng COOKIE, cấm nhét id phiên vào URL.

          Không khai dòng này thì Tomcat được phép dùng cách dự phòng
          ";jsessionid=..." gắn thẳng vào đường dẫn khi trình duyệt chưa nhận
          cookie. Mà id phiên nằm trên URL là nó theo vào lịch sử trình duyệt,
          vào header Referer gửi sang site khác, và vào link người dùng copy
          cho bạn bè — đưa luôn cả phiên đăng nhập của mình cho người ta.

          SameSite của cookie KHÔNG đặt được ở đây: web.xml phiên bản 3.1
          không có phần tử nào cho nó. Xem META-INF/context.xml.
        -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>


    <!--
      KHÔNG khai <welcome-file-list>.

      Trang chủ do HomeServlet map vào "" phụ trách. Nếu khai welcome-file thì
      Tomcat sẽ tìm file tĩnh trước và servlet không bao giờ chạy.
    -->

</web-app>
